---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CacaoGate from '../../components/CacaoGate.astro';
import GrillaHistorias from '../../components/GrillaHistorias.astro';
import { todasLasHistorias, type Historia } from '../../lib/historias';
import { fechaCorta, fechaIso, precio } from '../../lib/formato';
import { seccionPorId, slugTag } from '../../lib/secciones';
import { autorPorNombre, urlAutor } from '../../lib/autores';
import WidgetTravel from '../../components/WidgetTravel.astro';
import PagarBitcoin from '../../components/PagarBitcoin.astro';
import CompartirHistoria from '../../components/CompartirHistoria.astro';
import { TRAVEL_URL } from '../../lib/travel';
import { URL_MARKET } from '../../lib/grupo';
import { parsearCoordenadas } from '../../lib/cerca';

export async function getStaticPaths() {
  const todas = await todasLasHistorias();
  return todas.map((historia) => {
    // Same section first, then the newest of the rest, so there are always three.
    const otras = todas.filter((h) => h.id !== historia.id);
    const relacionadas = [
      ...otras.filter((h) => h.data.seccion === historia.data.seccion),
      ...otras.filter((h) => h.data.seccion !== historia.data.seccion),
    ].slice(0, 3);
    return { params: { slug: historia.id }, props: { historia, relacionadas } };
  });
}

interface Props {
  historia: Historia;
  relacionadas: Historia[];
}
const { historia, relacionadas } = Astro.props;
const { Content } = await render(historia);

const d = historia.data;
const seccion = seccionPorId(d.seccion);
const autor = autorPorNombre(d.autor);
const tipo = d.seccion === 'guia' ? 'guía' : d.seccion === 'cronica' ? 'crónica' : 'historia';
// The absolute address of this story, for the share row.
const urlHistoria = new URL(`/historias/${historia.id}/`, Astro.site).href;
// Where the story happens, so "¿Y ahora?" can suggest the Travel experience closest to it.
const punto = parsearCoordenadas(d.coords);
---

<Base titulo={d.titulo} descripcion={d.bajada} seccion={d.seccion} imagen={d.portada}>
  <div class="avance" data-avance aria-hidden="true"></div>
  <article class="historia" data-historia={historia.id} data-gate-estado={d.gratis ? 'gratis' : 'bloqueado'}>
    <header class="historia__cabeza contenedor">
      <p class="etiqueta"><a href={`/${seccion.ruta}/`}>{seccion.singular}</a> · {d.lugar}</p>
      <h1>{d.titulo}</h1>
      <p class="historia__bajada">{d.bajada}</p>
      <div class="historia__meta etiqueta">
        <span>Por {autor ? <a class="historia__firma" href={urlAutor(autor)}>{autor.nombre}</a> : d.autor}</span>
        <time datetime={fechaIso(d.fecha)}>{fechaCorta(d.fecha)}</time>
        <span>{d.minutos} min</span>
        {d.coords && <span>{d.coords}</span>}
        <span class="pastilla historia__estado" data-gate-pastilla data-precio={precio(d.precio)}>
          {d.gratis ? 'Gratis' : precio(d.precio)}
        </span>
      </div>
    </header>

    <figure class="historia__portada contenedor">
      <img src={d.portada} alt={d.alt} width="1600" height="1000" />
      {(d.credito || d.lugarFoto) && (
        <figcaption class="etiqueta">
          {d.credito && (
            <>
              Foto: {d.creditoUrl ? <a href={d.creditoUrl} rel="noopener">{d.credito}</a> : d.credito}
              {d.licencia && ` · ${d.licencia}`}
            </>
          )}
          {d.lugarFoto && (d.credito ? ` · Tomada en ${d.lugarFoto}` : `Tomada en ${d.lugarFoto}`)}
        </figcaption>
      )}
    </figure>

    <div class="historia__cuerpo">
      <div class="prosa">
        <Content />
      </div>
      {!d.gratis && <CacaoGate tipo={tipo} precio={precio(d.precio)} slug={historia.id} />}
    </div>

    <WidgetTravel historia={historia.id} lugar={d.lugar} seccion={d.seccion} />

    <!-- The next step after the story. Shown by the CSS once the story is read or unlocked (see the gate states below). -->
    <aside class="historia__siguiente" aria-labelledby={`siguiente-${historia.id}`}>
      <h2 class="historia__siguiente-titulo" id={`siguiente-${historia.id}`}>¿Y ahora?</h2>
      <div class="historia__siguiente-celdas">
        <a
          class="historia__siguiente-tarjeta"
          href={`${TRAVEL_URL}/`}
          data-siguiente-travel
          data-api={`${TRAVEL_URL}/api/tours.json`}
          data-historia={historia.id}
          data-lat={punto?.lat}
          data-lon={punto?.lon}
        >
          <span class="etiqueta" data-siguiente-etiqueta>Cacao Travel</span>
          <strong data-siguiente-titulo>Vivilo</strong>
          <span data-siguiente-texto>Experiencias en El Salvador, con precio en sats.</span>
        </a>
        <a class="historia__siguiente-tarjeta" href={`${URL_MARKET}/`}>
          <span class="etiqueta">Cacao Market</span>
          <strong>Llevate algo local</strong>
          <span>Productos y servicios locales, pagados en sats.</span>
        </a>
      </div>
    </aside>

    <PagarBitcoin coords={d.coords} />

    {
      autor && (
        <aside class="historia__autor">
          <p class="etiqueta">Escribe</p>
          <p class="historia__autor-nombre">
            <a href={urlAutor(autor)}>{autor.nombre}</a>
          </p>
          <p>{autor.bio}</p>
        </aside>
      )
    }

    <footer class="historia__pie">
      {d.tags.map((tag) => (
        <a class="pastilla" href={`/tags/${slugTag(tag)}/`}>{tag}</a>
      ))}
      <a href="/">Volver al inicio</a>
    </footer>

    <CompartirHistoria titulo={d.titulo} url={urlHistoria} />
  </article>
  <GrillaHistorias titulo="Seguí leyendo" historias={relacionadas} />
</Base>

<style>
  .avance {
    position: fixed;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--mazorca);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 10;
  }

  /* Header and photo are the two halves of the split bean: a thin gap, sharp inner corners. */
  .historia__cabeza {
    margin-top: 20px;
    padding: clamp(24px, 5vw, 64px);
    display: grid;
    gap: 18px;
    justify-items: start;
    background: var(--acento);
    color: var(--sobre-acento);
    border-radius: var(--radio) var(--radio) 6px 6px;
  }
  .historia__cabeza a { color: inherit; text-decoration: none; }
  .historia__cabeza a:hover { text-decoration: underline; }
  .historia__estado { background: var(--pulpa); color: var(--tostado); }
  .historia h1 {
    font-size: var(--t-display);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 18ch;
    overflow-wrap: anywhere;
  }
  .historia__bajada {
    font-size: var(--t-h2);
    font-weight: 400;
    max-width: 36ch;
  }
  .historia__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .historia__portada { margin: 8px auto 0; }
  .historia__portada img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px 6px var(--radio) var(--radio);
  }

  .historia__portada figcaption { margin-top: 10px; color: var(--tinta-suave); }

  .historia__cuerpo {
    width: min(100% - 2 * var(--canal), var(--ancho-lectura));
    margin: clamp(28px, 5vw, 56px) auto 0;
  }

  .historia__cabeza .historia__firma { text-decoration: underline; }
  .historia__autor {
    width: min(100% - 2 * var(--canal), var(--ancho-lectura));
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: 6px;
    background: var(--arena);
    border-radius: var(--radio-chico);
  }
  .historia__autor-nombre { font-size: var(--t-h2); font-weight: 800; }
  .historia__autor-nombre a { text-decoration: none; }
  .historia__autor-nombre a:hover { color: inherit; text-decoration: underline; }

  /* "¿Y ahora?" closes the story, same width as the text, on the arena ground the side cards use.
     Hidden until the story is read (free) or unlocked (paid), so a paid story never shows it before the payment. */
  .historia__siguiente {
    width: min(100% - 2 * var(--canal), var(--ancho-lectura));
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: clamp(20px, 3vw, 32px);
    display: none;
    gap: 16px;
    background: var(--arena);
    border-radius: var(--radio-chico);
  }
  .historia[data-gate-estado='desbloqueado'] .historia__siguiente,
  .historia[data-gate-estado='leyendo'] .historia__siguiente,
  .historia[data-gate-estado='gratis'] .historia__siguiente { display: grid; }
  .historia__siguiente-titulo { font-size: var(--t-h2); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
  .historia__siguiente-celdas { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .historia__siguiente-tarjeta {
    display: grid;
    gap: 6px;
    align-content: start;
    min-height: 44px;
    padding: 18px;
    background: var(--pulpa);
    color: var(--tostado);
    border-radius: var(--radio-chico);
    text-decoration: none;
  }
  .historia__siguiente-tarjeta strong { font-size: 1.25rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
  .historia__siguiente-tarjeta:hover { background: var(--tostado); color: var(--pulpa); }

  .historia__pie {
    width: min(100% - 2 * var(--canal), var(--ancho-lectura));
    margin: 40px auto 0;
    border-top: 1.5px solid var(--tostado);
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  /* Markdown output is not scoped, so these rules use :global(). */
  .prosa :global(p) { margin-block: 0 1.2em; font-size: 1.1875rem; line-height: 1.65; }
  .prosa > :global(p:first-child) { font-size: 1.5rem; line-height: 1.45; font-weight: 600; letter-spacing: -0.01em; }
  .prosa :global(h2) { margin-block: 1.8em 0.6em; font-weight: 800; }
  .prosa :global(blockquote) {
    margin: 0 0 1.6em;
    padding: 0.8em 1.1em;
    background: var(--arena);
    border-radius: var(--radio-chico);
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
  }
  .prosa :global(blockquote p) { margin: 0; font-size: inherit; }
  .prosa :global(ul),
  .prosa :global(ol) { padding-left: 1.2em; margin-block: 0 1.2em; }
  .prosa :global(li) { margin: 0.4em 0; }
  .prosa :global(a) { text-decoration: underline; }

  .historia :global([data-gate-cerrado]) { display: none; }
  .historia[data-gate-estado='desbloqueado'] :global([data-gate-cerrado]),
  .historia[data-gate-estado='leyendo'] :global([data-gate-cerrado]),
  .historia[data-gate-estado='gratis'] :global([data-gate-cerrado]) { display: block; }
  .historia[data-gate-estado='desbloqueado'] :global([data-gate-muro]),
  .historia[data-gate-estado='leyendo'] :global([data-gate-muro]),
  .historia[data-gate-estado='gratis'] :global([data-gate-muro]) { display: none; }
</style>

<script>
  // "¿Y ahora?": swap the generic Travel card for the experience linked to this story, or else the closest one.
  // Same public API the Travel widget uses. If it fails, the card keeps pointing at Travel's front page.
  interface Tour { titulo: string; url: string; precio: number; lugar: string; posicion?: [number, number]; historias?: string[] }
  const tarjeta = document.querySelector<HTMLAnchorElement>('[data-siguiente-travel]');
  const km = (a: [number, number], b: [number, number]) => {
    const r = (g: number) => (g * Math.PI) / 180;
    const h = Math.sin(r(b[0] - a[0]) / 2) ** 2 + Math.cos(r(a[0])) * Math.cos(r(b[0])) * Math.sin(r(b[1] - a[1]) / 2) ** 2;
    return 2 * 6371 * Math.asin(Math.min(1, Math.sqrt(h)));
  };
  if (tarjeta?.dataset.api) {
    fetch(tarjeta.dataset.api)
      .then((r) => (r.ok ? r.json() : null))
      .then((datos: { tours?: Tour[] } | null) => {
        const tours = datos?.tours ?? [];
        const id = tarjeta.dataset.historia ?? '';
        const lat = Number(tarjeta.dataset.lat);
        const lon = Number(tarjeta.dataset.lon);
        let elegido = tours.find((t) => t.historias?.includes(id));
        let distancia: number | null = null;
        if (!elegido && Number.isFinite(lat) && Number.isFinite(lon) && tarjeta.dataset.lat) {
          const conDistancia = tours
            .filter((t) => t.posicion)
            .map((t) => ({ t, d: km([lat, lon], t.posicion!) }))
            .sort((a, b) => a.d - b.d);
          if (conDistancia[0] && conDistancia[0].d <= 45) {
            elegido = conDistancia[0].t;
            distancia = conDistancia[0].d;
          }
        }
        if (!elegido) return;
        tarjeta.href = elegido.url;
        const etiqueta = tarjeta.querySelector('[data-siguiente-etiqueta]');
        const titulo = tarjeta.querySelector('[data-siguiente-titulo]');
        const texto = tarjeta.querySelector('[data-siguiente-texto]');
        if (etiqueta) etiqueta.textContent = distancia === null ? 'Cacao Travel · Vivilo' : `Cacao Travel · a ${Math.max(1, Math.round(distancia))} km`;
        if (titulo) titulo.textContent = elegido.titulo;
        if (texto) texto.textContent = `${elegido.lugar} · ${elegido.precio.toLocaleString('es-SV')} sats`;
      })
      .catch(() => {});
  }
</script>

<script>
  // Reading progress: answers the reader's own scrolling, nothing moves by itself.
  const avance = document.querySelector<HTMLElement>('[data-avance]');
  const texto = document.querySelector<HTMLElement>('.historia');
  if (avance && texto) {
    const pintarAvance = () => {
      const total = texto.offsetTop + texto.offsetHeight - window.innerHeight;
      const hecho = total > 0 ? Math.min(1, Math.max(0, window.scrollY / total)) : 0;
      avance.style.transform = `scaleX(${hecho})`;
    };
    window.addEventListener('scroll', pintarAvance, { passive: true });
    pintarAvance();
  }
</script>
