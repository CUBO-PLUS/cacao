---
import Simbolo from './Simbolo.astro';

interface Props {
  tipo: 'guía' | 'crónica' | 'historia';
  /** Already formatted, e.g. "120 sats". */
  precio: string;
  slug: string;
}
const { tipo, precio, slug } = Astro.props;
// Build-time switch for the demo panel. The payment routes check PUBLIC_DEMO again at run time.
const demo = import.meta.env.PUBLIC_DEMO === '1';
---

<aside class="muro" data-gate-muro data-slug={slug} data-paso="inicio" aria-label="Cacao Gate">
  <div class="muro__marca">
    <Simbolo tamano={56} fondo="oscuro" decorativo />
    <span class="muro__nombre"><b>cacao</b>gate</span>
  </div>
  <p class="muro__que">Cacao Gate: desbloqueás la historia completa, sin cuenta ni suscripción.</p>
  <h2 class="muro__titulo" tabindex="-1" data-gate-titulo>Desbloqueá esta {tipo} completa</h2>
  <p class="muro__estado" role="status" aria-live="polite" data-gate-estado-texto>
    Pagás una vez y la historia queda abierta en este navegador.
  </p>
  <p class="muro__error" role="alert" data-gate-error hidden></p>

  <p class="muro__precio" data-gate-precio>
    <span class="mono">{precio}</span>
    <span class="muro__usd mono" data-gate-usd hidden></span>
  </p>
  <p class="muro__que muro__sat" data-gate-sat>Un sat es la cienmillonésima parte de un bitcoin. El valor en dólares es al precio de hoy.</p>
  <p class="muro__cerrado" data-gate-cerrado-texto>Lo que sigue está cerrado: el resto de esta {tipo}, hasta el final.</p>

  <div class="muro__pendiente" data-gate-pendiente hidden>
    <div class="muro__factura">
      <img class="muro__qr" data-gate-qr alt="Código QR de la factura" width="200" height="200" />
      <div class="muro__datos">
        <p class="etiqueta">{demo ? 'Factura Lightning simulada' : 'Factura Lightning'}</p>
        <p class="muro__monto mono" data-gate-monto></p>
        <p class="muro__codigo mono" data-gate-factura></p>
        <button class="boton muro__secundario" type="button" data-gate-copiar>Copiar factura</button>
      </div>
    </div>
    <div class="muro__prueba" data-gate-prueba hidden>
      <p class="muro__nota muro__nota--fuerte"><b>¿No tenés billetera Lightning?</b> Pagá con esta billetera de prueba: abre en otra pestaña y la factura ya viene cargada.</p>
      <a class="boton muro__secundario" data-gate-billetera href="#" target="_blank" rel="noopener">Pagar con la billetera de prueba</a>
      <p class="muro__nota">Es bitcoin de prueba (regtest): no tiene valor y no se mueve dinero real.</p>
    </div>
    <p class="muro__cuenta">Vence en <span class="mono" data-gate-cuenta>5:00</span></p>
    {
      demo && (
        <div class="muro__demo" data-gate-demo>
          <p class="etiqueta muro__demo-titulo">Pago simulado (modo demo)</p>
          <div class="muro__acciones">
            <button class="boton" type="button" data-gate-simular>Simular pago</button>
            <button class="boton muro__secundario" type="button" data-gate-fallar>Simular pago fallido</button>
          </div>
        </div>
      )
    }
  </div>

  <p class="muro__motivo" data-gate-motivo hidden></p>

  <button
    class="boton muro__boton"
    type="button"
    data-gate-pedir
    data-texto-inicio={`Desbloquear por ${precio}`}
    data-texto-vencida="Pedir otra factura"
    data-texto-fallida="Intentar de nuevo"
  >Desbloquear por {precio}</button>

  <details class="muro__ya" data-gate-ya>
    <summary>Ya pagué, tengo un código</summary>
    <form class="muro__ya-form" data-gate-restaurar novalidate>
      <label class="etiqueta" for={`codigo-${slug}`}>Código de acceso</label>
      <textarea
        class="muro__campo mono"
        id={`codigo-${slug}`}
        rows="3"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        data-gate-codigo-entrada
        placeholder="Pegá aquí el código que guardaste"
      ></textarea>
      <button class="boton muro__secundario" type="submit" data-gate-restaurar-boton>Abrir con mi código</button>
      <p class="muro__nota">Sirve en cualquier navegador o celular, para esta historia y hasta que venza.</p>
    </form>
  </details>

  <p class="muro__nota">Tu acceso queda guardado en este navegador, sin cuenta ni suscripción. Para abrirla desde otro navegador o celular, usá tu código de acceso: lo ves cuando pagás.</p>
  {demo && <p class="etiqueta muro__demo-nota">Modo demo · no se cobra nada</p>}
</aside>

<style>
  .muro {
    background: var(--tostado);
    color: var(--pulpa);
    border-radius: var(--radio);
    padding: clamp(28px, 6vw, 56px);
    display: grid;
    gap: 14px;
    justify-items: start;
    min-width: 0;
  }
  .muro [hidden] { display: none; }

  .muro__marca { display: flex; align-items: center; gap: 12px; }
  .muro__nombre {
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .muro__nombre b { font-weight: 800; }

  .muro__titulo {
    font-size: var(--t-h1);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .muro__titulo:focus { outline: none; }
  .muro__que { color: var(--arena-oscura); }
  .muro__sat { font-size: 1rem; max-width: 40ch; }
  .muro__estado { font-weight: 600; max-width: 40ch; }
  .muro__error {
    background: var(--criollo);
    color: var(--pulpa);
    padding: 10px 14px;
    border-radius: var(--radio-chico);
    max-width: 100%;
  }
  .muro__nota { font-size: 1rem; color: var(--arena-oscura); }
  .muro__nota--fuerte { color: var(--pulpa); max-width: 42ch; }
  .muro__cerrado { color: var(--arena-oscura); max-width: 40ch; }
  .muro__demo-nota { color: var(--arena-oscura); }

  .muro__precio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .muro__usd { font-size: 1rem; font-weight: 500; color: var(--arena-oscura); }

  .muro__pendiente { display: grid; gap: 16px; width: 100%; min-width: 0; }
  .muro__factura {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
  }
  .muro__qr {
    width: 200px;
    height: 200px;
    max-width: 100%;
    padding: 8px;
    background: var(--blanco-calido);
    border-radius: var(--radio-chico);
  }
  .muro__datos { display: grid; gap: 8px; justify-items: start; flex: 1 1 200px; min-width: 0; }
  .muro__monto { font-size: 1.125rem; font-weight: 500; }
  .muro__codigo {
    font-size: var(--t-etiqueta);
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  .muro__prueba { display: grid; gap: 8px; justify-items: start; }
  .muro__cuenta { font-size: 1.125rem; }
  .muro__cuenta .mono { font-weight: 500; }
  .muro__demo {
    display: grid;
    gap: 10px;
    padding: 16px;
    border: 1.5px dashed var(--arena-oscura);
    border-radius: var(--radio-chico);
  }
  .muro__demo-titulo { color: var(--pulpa); }
  .muro__acciones { display: flex; flex-wrap: wrap; gap: 10px; }
  .muro__motivo { color: var(--arena); }

  .muro__boton { min-height: 44px; }
  .muro__secundario {
    min-height: 44px;
    background: transparent;
    color: var(--pulpa);
    border: 1.5px solid var(--pulpa);
  }
  .muro__secundario:hover { background: var(--pulpa); color: var(--tostado); }
  .muro .boton:hover { background: var(--pulpa); color: var(--tostado); }
  .muro .boton:disabled { opacity: 0.6; cursor: wait; }
  .muro .boton:focus-visible { outline: 3px solid var(--mazorca); outline-offset: 3px; }

  .muro__ya { width: 100%; min-width: 0; }
  .muro__ya summary {
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .muro__ya-form { display: grid; gap: 10px; justify-items: start; padding-top: 10px; min-width: 0; width: 100%; }
  .muro__campo {
    width: 100%;
    min-width: 0;
    padding: 12px 14px;
    border-radius: var(--radio-chico);
    border: 1.5px solid var(--pulpa);
    background: var(--blanco-calido);
    color: var(--tostado);
    font: inherit;
    font-size: var(--t-etiqueta);
    resize: vertical;
    overflow-wrap: anywhere;
  }
  .muro__campo:focus-visible { outline: 3px solid var(--mazorca); outline-offset: 2px; }
  .muro [hidden] { display: none; }

  /* The access code, shown at the start of the unlocked text. Global: the text is put in by the script. */
  :global(.gate-codigo) {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin: 0 0 2em;
    padding: clamp(20px, 4vw, 28px);
    background: var(--tostado);
    color: var(--pulpa);
    border-radius: var(--radio);
    min-width: 0;
  }
  :global(.gate-codigo .gate-codigo__valor) {
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
    overflow-wrap: anywhere;
    max-width: 100%;
    background: var(--chocolate);
    padding: 10px 12px;
    border-radius: var(--radio-chico);
    user-select: all;
  }
  :global(.gate-codigo p) { margin: 0; color: var(--arena-oscura); }
  :global(.gate-codigo .gate-codigo__titulo) { color: var(--pulpa); font-weight: 800; font-size: var(--t-h2); }
  :global(.gate-codigo .gate-codigo__acciones) { display: flex; flex-wrap: wrap; gap: 10px; }
  :global(.gate-codigo .boton) { min-height: 44px; }
</style>

<script>
  import QRCode from 'qrcode';
  import { estadoGate, guardarAcceso, tokenDe, traerCerrado } from '../lib/gate';

  type Paso = 'inicio' | 'pendiente' | 'pagada' | 'vencida' | 'fallida' | 'sin-base';
  interface Respuesta {
    estado?: string;
    id?: string;
    factura?: string;
    precioSats?: number;
    precioUsdCentavos?: number | null;
    segundosRestantes?: number;
    billeteraDePrueba?: string | null;
    token?: string;
    motivo?: string | null;
    error?: string;
  }

  const MENSAJE_RED = 'No pudimos conectar. Revisá tu conexión y probá de nuevo.';
  const MENSAJE_FACTURA = 'No pudimos crear la factura. Revisá tu conexión y probá de nuevo.';
  const MENSAJE_VENCIDA = 'La factura venció. No la pagués.';
  const SIN_BASE = 'Los pagos no están disponibles en este momento.';
  const SIN_COMPRAR = 'Sin cuenta ni suscripción: pagás una vez y la historia queda abierta en este navegador.';
  const SONDEO_MS = 3000;
  const PAUSA_RECIBO_MS = 1200;

  const muro = document.querySelector<HTMLElement>('[data-gate-muro]');
  const articulo = document.querySelector<HTMLElement>('article[data-historia]');
  if (muro && articulo && articulo.dataset.gateEstado !== 'gratis') iniciarGate(muro, articulo);

  function textoUsd(centavos: number): string {
    return (centavos / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  }

  function textoMonto(sats: number, centavos: number | null | undefined): string {
    const texto = `${sats.toLocaleString('en-US')} sats`;
    return centavos ? `${texto} · ${textoUsd(centavos)}` : texto;
  }

  // Dark modules Tostado on Blanco cálido, read from the brand tokens.
  async function codigoQr(texto: string): Promise<string> {
    const estilo = getComputedStyle(document.documentElement);
    const oscuro = estilo.getPropertyValue('--tostado').trim() || '#2A1912';
    const claro = estilo.getPropertyValue('--blanco-calido').trim() || '#FFFAF4';
    return QRCode.toDataURL(texto, { margin: 1, width: 200, color: { dark: oscuro, light: claro } });
  }

  function iniciarGate(muro: HTMLElement, articulo: HTMLElement): void {
    const slug = muro.dataset.slug ?? '';
    const dentro = <T extends HTMLElement>(selector: string) => muro.querySelector<T>(selector);
    const cerrado = articulo.querySelector<HTMLElement>('[data-gate-cerrado]');
    const pastilla = articulo.querySelector<HTMLElement>('[data-gate-pastilla]');
    const precioLinea = dentro('[data-gate-precio]');
    const cerradoTexto = dentro('[data-gate-cerrado-texto]');
    const usd = dentro('[data-gate-usd]');
    const pendiente = dentro('[data-gate-pendiente]');
    const qr = dentro<HTMLImageElement>('[data-gate-qr]');
    const monto = dentro('[data-gate-monto]');
    const factura = dentro('[data-gate-factura]');
    const copiar = dentro<HTMLButtonElement>('[data-gate-copiar]');
    const cuenta = dentro('[data-gate-cuenta]');
    const simular = dentro<HTMLButtonElement>('[data-gate-simular]');
    const fallar = dentro<HTMLButtonElement>('[data-gate-fallar]');
    const motivo = dentro('[data-gate-motivo]');
    const pedir = dentro<HTMLButtonElement>('[data-gate-pedir]');
    const estadoTexto = dentro('[data-gate-estado-texto]');
    const aviso = dentro('[data-gate-error]');
    const prueba = dentro('[data-gate-prueba]');
    const billetera = dentro<HTMLAnchorElement>('[data-gate-billetera]');
    const ya = dentro<HTMLDetailsElement>('[data-gate-ya]');
    const restaurar = dentro<HTMLFormElement>('[data-gate-restaurar]');
    const entrada = dentro<HTMLTextAreaElement>('[data-gate-codigo-entrada]');
    const restaurarBoton = dentro<HTMLButtonElement>('[data-gate-restaurar-boton]');

    let cobro: string | null = null;
    let vence = 0;
    let sondeo: number | undefined;
    let reloj: number | undefined;
    let consultando = false;
    let venciendo = false;
    let observandoLectura = false;

    // Funnel events: fire and forget, never shown to the reader.
    function enviar(nombre: string): void {
      fetch('/api/evento/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, objeto: slug, ruta: location.pathname }),
        keepalive: true,
      }).catch(() => {});
    }

    function decir(texto: string): void {
      if (estadoTexto) estadoTexto.textContent = texto;
    }

    function error(texto: string | null): void {
      if (!aviso) return;
      aviso.textContent = texto ?? '';
      aviso.hidden = !texto;
    }

    function ocupado(on: boolean): void {
      for (const boton of [pedir, simular, fallar, restaurarBoton]) if (boton) boton.disabled = on;
    }

    function pintarArticulo(estado: 'bloqueado' | 'desbloqueado' | 'leyendo'): void {
      articulo.dataset.gateEstado = estado;
      if (!pastilla) return;
      pastilla.textContent =
        estado === 'bloqueado' ? (pastilla.dataset.precio ?? '') : estado === 'desbloqueado' ? 'Desbloqueado' : 'Leyendo';
    }

    function pintarUsd(centavos: number | null | undefined): void {
      if (!usd) return;
      usd.hidden = !centavos;
      usd.textContent = centavos ? `· ${textoUsd(centavos)}` : '';
    }

    // The test-wallet link, only for BTCPay invoices on a regtest demo. Hidden otherwise.
    function pintarPrueba(enlace: string | null | undefined): void {
      if (!prueba) return;
      prueba.hidden = !enlace;
      if (billetera) billetera.href = enlace ?? '#';
    }

    function detenerPendiente(): void {
      clearInterval(sondeo);
      clearInterval(reloj);
      sondeo = undefined;
      reloj = undefined;
    }

    function mostrar(paso: Paso, texto: string): void {
      muro.dataset.paso = paso;
      decir(texto);
      if (precioLinea) precioLinea.hidden = paso !== 'inicio';
      if (cerradoTexto) cerradoTexto.hidden = paso !== 'inicio';
      if (pendiente) pendiente.hidden = paso !== 'pendiente';
      if (motivo) motivo.hidden = paso !== 'fallida';
      // The code field is for a reader who has not paid on this browser: not while an invoice is open.
      if (ya) ya.hidden = paso === 'pendiente' || paso === 'pagada' || paso === 'sin-base';
      if (pedir) {
        pedir.hidden = !['inicio', 'vencida', 'fallida'].includes(paso);
        pedir.textContent =
          paso === 'vencida'
            ? (pedir.dataset.textoVencida ?? '')
            : paso === 'fallida'
              ? (pedir.dataset.textoFallida ?? '')
              : (pedir.dataset.textoInicio ?? '');
      }
      if (paso !== 'pendiente') detenerPendiente();
    }

    function pintarCuenta(): number {
      const restante = Math.max(0, Math.ceil((vence - Date.now()) / 1000));
      if (cuenta) cuenta.textContent = `${Math.floor(restante / 60)}:${String(restante % 60).padStart(2, '0')}`;
      return restante;
    }

    // Starts the countdown and the 3-second poll for one pending invoice.
    function vigilar(id: string): void {
      detenerPendiente();
      cobro = id;
      venciendo = false;
      reloj = window.setInterval(() => {
        // At zero the server decides whether the invoice is vencida.
        if (pintarCuenta() === 0 && !venciendo) {
          venciendo = true;
          void consultar();
        }
      }, 1000);
      sondeo = window.setInterval(() => {
        if (document.visibilityState === 'visible') void consultar();
      }, SONDEO_MS);
    }

    function aplicar(datos: Respuesta): void {
      switch (datos.estado) {
        case 'pendiente':
          vence = Date.now() + (datos.segundosRestantes ?? 0) * 1000;
          venciendo = false;
          pintarPrueba(datos.billeteraDePrueba);
          pintarCuenta();
          return;
        case 'pagada':
          void cobrado(datos.token ?? '', true);
          return;
        case 'vencida':
          mostrar('vencida', MENSAJE_VENCIDA);
          return;
        case 'fallida':
          if (motivo) motivo.textContent = datos.motivo ?? '';
          mostrar('fallida', 'El pago no se completó.');
          return;
      }
    }

    async function adoptar(datos: Respuesta): Promise<void> {
      if (!datos.id || !datos.factura) throw new Error('Respuesta incompleta.');
      if (factura) factura.textContent = datos.factura;
      if (monto) monto.textContent = textoMonto(datos.precioSats ?? 0, datos.precioUsdCentavos);
      if (qr) qr.src = await codigoQr(datos.factura);
      if (copiar) copiar.textContent = 'Copiar factura';
      vence = Date.now() + (datos.segundosRestantes ?? 0) * 1000;
      pintarPrueba(datos.billeteraDePrueba);
      mostrar('pendiente', 'Esperando el pago. Esta página se actualiza sola.');
      pintarCuenta();
      vigilar(datos.id);
    }

    async function consultar(): Promise<void> {
      if (!cobro || consultando) return;
      consultando = true;
      try {
        const r = await fetch(`/api/cobro/${cobro}/`, { cache: 'no-store' });
        if (r.status === 404) {
          cobro = null;
          mostrar('inicio', SIN_COMPRAR);
          error('No encontramos esa factura. Pedí otra.');
          return;
        }
        if (r.ok) aplicar((await r.json()) as Respuesta);
      } catch {
        // Offline for a moment: the next poll tries again.
      } finally {
        consultando = false;
      }
    }

    // Reading unlocked: the first scroll starts the observers, so loading the page is not reading yet.
    // The observers are kept in this scope on purpose: an observer that nothing refers to can be collected,
    // and then the "leyó hasta el final" event never fires.
    let observadorTexto: IntersectionObserver | null = null;
    let observadorFin: IntersectionObserver | null = null;

    function observarLectura(): void {
      if (observandoLectura || !cerrado || !('IntersectionObserver' in window)) return;
      observandoLectura = true;
      window.addEventListener(
        'scroll',
        () => {
          if (!cerrado) return;
          const texto = cerrado;
          observadorTexto = new IntersectionObserver((entradas, o) => {
            if (!entradas.some((e) => e.isIntersecting)) return;
            pintarArticulo('leyendo');
            o.disconnect();
          });
          observadorTexto.observe(texto);
          const fin = texto.querySelector('[data-gate-fin]');
          if (fin) {
            observadorFin = new IntersectionObserver((entradas, o) => {
              if (!entradas.some((e) => e.isIntersecting)) return;
              enviar('leyo_completa');
              o.disconnect();
            });
            observadorFin.observe(fin);
          }
        },
        { once: true, passive: true },
      );
    }

    // The access code: the pass this browser keeps, shown first so the reader can save or copy it.
    // Built with DOM calls, so nothing from the page is parsed as HTML.
    function cajaCodigo(codigo: string, expira: number): HTMLElement {
      const caja = document.createElement('section');
      caja.className = 'gate-codigo';
      caja.dataset.gateCodigo = '';
      caja.setAttribute('aria-label', 'Código de acceso');

      const titulo = document.createElement('p');
      titulo.className = 'gate-codigo__titulo';
      titulo.textContent = 'Tu código de acceso';

      const texto = document.createElement('p');
      const fecha = new Date(expira).toLocaleDateString('es-SV', { day: 'numeric', month: 'long', year: 'numeric' });
      texto.textContent = `Guardalo o copialo. Sirve en cualquier navegador o celular para esta historia, hasta el ${fecha}. Pegalo en el muro con «Ya pagué, tengo un código».`;

      const valor = document.createElement('p');
      valor.className = 'gate-codigo__valor';
      valor.textContent = codigo;

      const acciones = document.createElement('div');
      acciones.className = 'gate-codigo__acciones';

      const copia = document.createElement('button');
      copia.type = 'button';
      copia.className = 'boton';
      copia.textContent = 'Copiar código';
      copia.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(codigo);
          copia.textContent = 'Código copiado';
        } catch {
          copia.textContent = 'No pudimos copiar: seleccionalo a mano';
        }
      });

      const guardar = document.createElement('button');
      guardar.type = 'button';
      guardar.className = 'boton';
      guardar.textContent = 'Guardar en un archivo';
      guardar.addEventListener('click', () => {
        const cuerpo = `Código de acceso de Cacao Media\nHistoria: ${slug}\nVence: ${fecha}\n\n${codigo}\n`;
        const url = URL.createObjectURL(new Blob([cuerpo], { type: 'text/plain' }));
        const enlace = document.createElement('a');
        enlace.href = url;
        enlace.download = `cacao-media-codigo-${slug}.txt`;
        document.body.append(enlace);
        enlace.click();
        enlace.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });

      acciones.append(copia, guardar);
      caja.append(titulo, texto, valor, acciones);
      return caja;
    }

    // The locked text goes into the page only now, from the server, with the reader's token.
    async function abrir(html: string, enfocar: boolean): Promise<void> {
      if (!cerrado) return;
      cerrado.innerHTML = '';
      const pase = tokenDe(slug);
      if (pase) cerrado.append(cajaCodigo(pase.token, pase.expira));
      cerrado.insertAdjacentHTML('beforeend', html);
      const fin = document.createElement('span');
      fin.dataset.gateFin = '';
      fin.setAttribute('aria-hidden', 'true');
      cerrado.append(fin);
      error(null);
      pintarArticulo('desbloqueado');
      observarLectura();
      if (enfocar) {
        cerrado.tabIndex = -1;
        // Focus without scrolling: the page must not jump under the reader.
        cerrado.focus({ preventScroll: true });
      }
    }

    // Stores the token, then opens the story. `recibo` shows "Pago recibido" first.
    async function cobrado(token: string, recibo: boolean): Promise<void> {
      if (recibo) {
        mostrar('pagada', 'Pago recibido.');
        await new Promise((resolver) => setTimeout(resolver, PAUSA_RECIBO_MS));
      }
      if (!guardarAcceso(slug, token)) {
        mostrar('inicio', SIN_COMPRAR);
        error(MENSAJE_RED);
        return;
      }
      const html = await traerCerrado(slug);
      if (html === null) {
        mostrar('inicio', SIN_COMPRAR);
        error(MENSAJE_RED);
        return;
      }
      await abrir(html, true);
    }

    async function pedirFactura(): Promise<void> {
      ocupado(true);
      error(null);
      try {
        const r = await fetch('/api/cobro/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        const datos = ((await r.json().catch(() => ({}))) ?? {}) as Respuesta;
        if (!r.ok) {
          error(datos.error ?? MENSAJE_FACTURA);
          return;
        }
        if (datos.estado === 'pagada') {
          // Already paid from this browser: no receipt, the story opens.
          await cobrado(datos.token ?? '', false);
          return;
        }
        await adoptar(datos);
      } catch {
        error(MENSAJE_RED);
      } finally {
        ocupado(false);
      }
    }

    async function accionDemo(accion: 'pagar' | 'fallar'): Promise<void> {
      if (!cobro) return;
      ocupado(true);
      error(null);
      try {
        const r = await fetch(`/api/cobro/${cobro}/${accion}/`, { method: 'POST' });
        const datos = ((await r.json().catch(() => ({}))) ?? {}) as Respuesta;
        if (r.ok && datos.estado === 'pagada') {
          await cobrado(datos.token ?? '', true);
          return;
        }
        if (r.ok && datos.estado === 'fallida') {
          aplicar(datos);
          return;
        }
        if (datos.estado === 'vencida') {
          mostrar('vencida', MENSAJE_VENCIDA);
          error(datos.error ?? null);
          return;
        }
        error(datos.error ?? MENSAJE_RED);
      } catch {
        error(MENSAJE_RED);
      } finally {
        ocupado(false);
      }
    }

    async function alCargar(): Promise<void> {
      enviar('vista_historia');

      if (estadoGate(slug) === 'desbloqueado') {
        try {
          const html = await traerCerrado(slug);
          if (html !== null) {
            await abrir(html, false);
            return;
          }
        } catch {
          // The token is kept; the server check below decides.
        }
      }

      // No token, or the server refused the stored one: ask whether this browser has paid for the story.
      try {
        const r = await fetch('/api/desbloquear/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        const datos = ((await r.json().catch(() => ({}))) ?? {}) as Respuesta;
        if (r.status === 503) {
          mostrar('sin-base', SIN_BASE);
          return;
        }
        if (r.status === 402) {
          pintarUsd(datos.precioUsdCentavos);
          return;
        }
        if (!r.ok || !datos.token || !guardarAcceso(slug, datos.token)) {
          error(MENSAJE_RED);
          return;
        }
        const html = await traerCerrado(slug);
        if (html === null) {
          error(MENSAJE_RED);
          return;
        }
        await abrir(html, false);
      } catch {
        error(MENSAJE_RED);
      }
    }

    // Restores access from a code typed on this browser. The server checks the code; the pass is then kept here.
    async function restaurarCon(codigo: string): Promise<void> {
      ocupado(true);
      error(null);
      try {
        const r = await fetch('/api/codigo/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, codigo }),
        });
        const datos = ((await r.json().catch(() => ({}))) ?? {}) as Respuesta;
        if (!r.ok) {
          error(datos.error ?? MENSAJE_RED);
          return;
        }
        await cobrado(datos.token ?? codigo, false);
      } catch {
        error(MENSAJE_RED);
      } finally {
        ocupado(false);
      }
    }

    restaurar?.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const codigo = (entrada?.value ?? '').replace(/\s+/g, '');
      if (!codigo) {
        error('Escribí o pegá tu código de acceso.');
        entrada?.focus();
        return;
      }
      void restaurarCon(codigo);
    });

    pedir?.addEventListener('click', () => void pedirFactura());
    simular?.addEventListener('click', () => void accionDemo('pagar'));
    fallar?.addEventListener('click', () => void accionDemo('fallar'));
    copiar?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(factura?.textContent ?? '');
        if (copiar) copiar.textContent = 'Factura copiada';
      } catch {
        error('No pudimos copiar la factura. Seleccionála y copiala a mano.');
      }
    });
    // Back on the tab: refresh at once instead of waiting for the next tick.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && cobro && muro.dataset.paso === 'pendiente') void consultar();
    });

    // The wall counts as seen once it is on screen.
    if ('IntersectionObserver' in window) {
      const observadorMuro = new IntersectionObserver((entradas, o) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        enviar('vio_muro');
        o.disconnect();
      });
      observadorMuro.observe(muro);
    }

    void alCargar();
  }
</script>
