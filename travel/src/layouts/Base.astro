---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import GrupoCacao from '../components/GrupoCacao.astro';
import Logo from '../components/Logo.astro';
import Telon from '../components/Telon.astro';
import { Show, SignInButton, UserButton } from '@clerk/astro/components';
import { MEDIA_URL } from '../lib/tours';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}
const {
  titulo,
  descripcion = 'Reservá experiencias en El Salvador: volcanes, playa, café y pueblos. Precios en sats.',
  imagen,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Cacao Travel` : 'Cacao Travel · Experiencias en El Salvador';
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-SV">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#2A1912" />
    <!-- Demo catalogue: keep out of search engines until the experiences are real. -->
    <meta name="robots" content="noindex" />
    <meta property="og:site_name" content="Cacao Travel" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {imagen && <meta property="og:image" content={new URL(imagen, Astro.site)} />}
  </head>
  <body>
    <Telon />
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="hoja">
      <p class="aviso">Modo demo: experiencias de muestra y pagos de prueba.</p>
      <div class="barra">
        <header class="cabecera contenedor">
          <a href="/" aria-label="Cacao Travel, inicio"><Logo /></a>
          <button type="button" class="menu__boton" aria-expanded="false" aria-controls="menu-principal" data-menu>Menú</button>
          <nav id="menu-principal" aria-label="Principal" data-menu-panel>
            <a href="/#experiencias">Experiencias</a>
            <a href="/mapa/">Mapa</a>
            <a href="/reservas/">Mis reservas</a>
            <a href="/operadores/">Operadores</a>
            <a href={`${MEDIA_URL}/`}>Cacao Media</a>
            <!-- isStatic: most pages are prerendered, so the sign-in state is read in the browser. -->
            <Show when="signed-out" isStatic class="cabecera__entrar">
              <SignInButton mode="modal">Entrar</SignInButton>
            </Show>
            <Show when="signed-in" isStatic>
              <UserButton />
            </Show>
          </nav>
        </header>
      </div>
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="pie contenedor">
      <p class="pie__gigante" aria-hidden="true"><b>cacao</b>travel</p>
      <div class="pie__fila">
        <p>Experiencias en El Salvador, con precio en sats.</p>
        <nav aria-label="Pie">
          <a href="/#experiencias">Experiencias</a>
          <a href="/mapa/">Mapa</a>
          <a href="/reservas/">Mis reservas</a>
          <a href="/operadores/">Operadores</a>
          <a href="/api/tours.json">API</a>
          <a href={`${MEDIA_URL}/`}>Cacao Media</a>
          <a href="/creditos/">Créditos de fotos</a>
          <a href="https://cacao-grupo.vercel.app/legal.html">Términos y privacidad</a>
        </nav>
      </div>
      <p class="pie__nota">Parte de Cacao Media · precios en sats · catálogo de muestra</p>
      <GrupoCacao actual="travel" />
    </footer>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -999px; top: 8px; background: var(--mazorca); color: var(--tostado); padding: 0.5em 1em; border-radius: 999px; z-index: 10; }
  .saltar:focus { left: 8px; }

  /* Pulpa sheet on a Tostado ground, aligned with Cacao Media. */
  .hoja {
    background: var(--pulpa);
    margin-inline: clamp(0px, 1.5vw, 20px);
    border-radius: 0 0 var(--radio) var(--radio);
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .barra { background: var(--pulpa); }
  @media (min-width: 861px) {
    .barra { position: sticky; top: 0; z-index: 5; }
  }

  main:focus { outline: none; }

  /* Quiet demo notice: one small line, no banner. */
  .aviso { margin: 0; padding: 8px var(--canal) 0; font-size: 0.75rem; line-height: 1.4; color: var(--tinta-suave); }

  /* Phone: the logo and a Menú button on one line; the links open below the bar. */
  .cabecera {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1.5px solid var(--tostado);
  }
  .cabecera > a { text-decoration: none; }
  .cabecera > a :global(.logo) { color: var(--tostado); }
  .menu__boton {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1em;
    border: 1.5px solid var(--chocolate);
    border-radius: 999px;
    background: transparent;
    color: var(--tostado);
    font: 600 1rem/1 var(--fuente);
    cursor: pointer;
  }
  .menu__boton:hover, .menu__boton[aria-expanded='true'] { border-color: var(--mazorca); color: var(--mazorca); }
  .cabecera nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 6;
    display: none;
    flex-direction: column;
    padding: 4px var(--canal) 16px;
    background: var(--pulpa);
    border-bottom: 1.5px solid var(--tostado);
  }
  .cabecera nav[data-abierto] { display: flex; }
  .cabecera nav a, .cabecera nav :global(.cabecera__entrar button) { min-height: 48px; justify-content: flex-start; }
  .cabecera nav a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  @media (min-width: 861px) {
    .menu__boton { display: none; }
    .cabecera { padding-block: 16px; gap: 24px; }
    .cabecera nav {
      position: static;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 22px;
      padding: 0;
      background: none;
      border: 0;
    }
    .cabecera nav a { min-height: 36px; }
  }
  .cabecera nav a:hover { color: var(--mazorca); }
  /* The sign-in button is a button, so it takes the same size and label as the links in the bar. */
  .cabecera nav :global(.cabecera__entrar button) {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
  }
  .cabecera nav :global(.cabecera__entrar button:hover) { color: var(--mazorca); }

  .pie {
    overflow: hidden;
    display: grid;
    gap: 20px;
    padding-block: clamp(40px, 6vw, 72px);
    color: var(--pulpa);
  }
  /* Sized by the footer's own width, so the whole word always fits, on any screen. */
  .pie { container-type: inline-size; }
  .pie__gigante {
    font-size: 19.2cqi;
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--chocolate);
    margin-bottom: clamp(16px, 3vw, 40px);
  }
  .pie__gigante b { font-weight: 800; }
  .pie__fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; }
  .pie nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .pie a:hover { color: var(--mazorca); }
  .pie__nota { font-size: 0.875rem; color: var(--arena-oscura); }
</style>

<script>
  import { pintarUsd } from '../lib/usd';

  // Approximate dollar values next to the sats prices. Pages without a rate keep the sats alone.
  void pintarUsd();

  // Phone menu: opens under the bar, closes on Escape, on a choice, and on a second press.
  const boton = document.querySelector<HTMLButtonElement>('[data-menu]');
  const menu = document.querySelector<HTMLElement>('[data-menu-panel]');
  const cambiar = (abierto: boolean) => {
    if (!boton || !menu) return;
    boton.setAttribute('aria-expanded', String(abierto));
    menu.toggleAttribute('data-abierto', abierto);
  };
  boton?.addEventListener('click', () => cambiar(boton.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a, button')) cambiar(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || boton?.getAttribute('aria-expanded') !== 'true') return;
    cambiar(false);
    boton.focus();
  });
</script>
