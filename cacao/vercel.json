{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "legal.html",
      "use": "@vercel/static"
    },
    {
      "src": "alcance.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitio.js",
      "use": "@vercel/static"
    },
    {
      "src": "alcance.css",
      "use": "@vercel/static"
    },
    {
      "src": "alcance.js",
      "use": "@vercel/static"
    },
    {
      "src": "datos/**",
      "use": "@vercel/static"
    },
    {
      "src": "estilo.css",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "ledger/**",
      "use": "@vercel/static"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
