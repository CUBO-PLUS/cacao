---
// Lead story: the first thing on the home page. Photo, then the story in its section colour.
// On a phone the photo sits on top, the title right under it; on a wide screen the two halves
// sit side by side, like the split bean in the logo.
import { fechaCorta, fechaIso } from '../lib/formato';
import { urlHistoria, type Historia } from '../lib/historias';
import { seccionPorId } from '../lib/secciones';
import Precio from './Precio.astro';

interface Props {
  historia: Historia;
}
const { historia } = Astro.props;
const d = historia.data;
const seccion = seccionPorId(d.seccion);
const url = urlHistoria(historia);
---

<article class="portada contenedor" data-seccion={d.seccion}>
  <a class="portada__foto" href={url} tabindex="-1" aria-hidden="true">
    <img src={d.portada} alt="" width="1600" height="1000" fetchpriority="high" />
  </a>
  <div class="portada__texto">
    <p class="portada__seccion"><a href={`/${seccion.ruta}/`}>{seccion.singular}</a> · {d.lugar}</p>
    <h1 class="portada__titulo"><a href={url}>{d.titulo}</a></h1>
    <p class="portada__bajada">{d.bajada}</p>
    <div class="portada__datos">
      <Precio gratis={d.gratis} precio={d.precio} />
      <time class="etiqueta" datetime={fechaIso(d.fecha)}>{fechaCorta(d.fecha).toLowerCase()}</time>
      <span class="etiqueta">{d.minutos} min</span>
    </div>
    <a class="portada__boton" href={url} tabindex="-1" aria-hidden="true">Leer historia</a>
  </div>
</article>

<style>
  .portada {
    --corte: 8px;
    --filo: 6px;
    display: grid;
    gap: var(--corte);
    margin-top: 16px;
  }
  .portada__foto {
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radio) var(--radio) var(--filo) var(--filo);
  }
  .portada__foto img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .portada__texto {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 12px;
    min-width: 0;
    padding: 22px 20px 24px;
    background: var(--acento);
    color: var(--sobre-acento);
    border-radius: var(--filo) var(--filo) var(--radio) var(--radio);
  }
  .portada__seccion { font-family: var(--mono); font-size: var(--t-etiqueta); letter-spacing: 0.01em; }
  .portada__datos .etiqueta { text-transform: none; letter-spacing: 0.01em; }
  .portada__texto a { color: inherit; text-decoration: none; }
  .portada__texto a:hover { text-decoration: underline; }
  .portada__titulo {
    font-size: clamp(2rem, 4.4vw, 4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  /* On a phone the summary waits for the story page, so the next stories show in the first view. */
  .portada__bajada { display: none; }
  .portada__datos { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .portada__boton {
    display: inline-flex;
    padding: 0.8em 1.4em;
    border-radius: 999px;
    background: var(--pulpa);
    color: var(--tostado) !important;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
  }
  .portada__boton:hover { background: var(--tostado); color: var(--pulpa) !important; text-decoration: none !important; }

  @media (min-width: 900px) {
    .portada { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); margin-top: 20px; }
    .portada__foto { border-radius: var(--radio) var(--filo) var(--filo) var(--radio); }
    .portada__foto img { aspect-ratio: auto; min-height: min(62vh, 600px); }
    .portada__texto {
      align-content: end;
      padding: clamp(28px, 4vw, 52px);
      border-radius: var(--filo) var(--radio) var(--radio) var(--filo);
    }
    .portada__titulo { font-size: clamp(2.5rem, 4.2vw, 4rem); }
    .portada__bajada { display: block; font-size: 1.25rem; line-height: 1.4; max-width: 30ch; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada__foto img { transition: transform 0.5s ease; }
    .portada:hover .portada__foto img { transform: scale(1.03); }
  }
</style>
